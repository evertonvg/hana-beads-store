# Copy to .env.local for local development. Never commit real secrets.

# Data adapter (required, no default: it gates the /api/__mock__/* test routes). "mock" or "supabase".
DATA_SOURCE=mock
# Session cookie secret (iron-session). Only used by the mock adapter (DATA_SOURCE=mock). 32+ characters.
SESSION_SECRET=dev-secret-dev-secret-dev-secret-00

# Supabase (required when DATA_SOURCE=supabase). Local defaults come from `npx supabase status -o env`
# after `npm run db:start`: API_URL, PUBLISHABLE_KEY and SECRET_KEY. These are the well-known local-only
# demo keys; real environments use their own and never commit them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared secret for the on-demand revalidation route. 32+ characters.
REVALIDATE_SECRET=dev-revalidate-dev-revalidate-0000
# Header that carries the client IP behind the proxy (rate limits)
CLIENT_IP_HEADER=x-forwarded-for

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "instagram" or "whatsapp"
NEXT_PUBLIC_CONTACT_CHANNEL=instagram
# Empty = "[usuario]" placeholder
NEXT_PUBLIC_INSTAGRAM_USER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Free shipping threshold in cents. Empty = placeholder
NEXT_PUBLIC_FREE_SHIPPING_CENTS=
# Parallax intensity, 0 to 2
NEXT_PUBLIC_PARALLAX_INTENSITY=1
NEXT_PUBLIC_AUTH_APPLE=false
# Analytics script URL. Empty = nothing is loaded
NEXT_PUBLIC_ANALYTICS_SRC=
